generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Organization ───────────────────────────────────────────────────

model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  scope       RoleScope
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users           User[]
  customerUsers   CustomerUser[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(200)
  category  String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id") @db.UnsignedBigInt
  permissionId BigInt @map("permission_id") @db.UnsignedBigInt

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employeeNo        String    @unique @map("employee_no") @db.VarChar(20)
  haccpNo           String?   @unique @map("haccp_no") @db.VarChar(20)
  name              String    @db.VarChar(100)
  email             String?   @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime? @map("password_changed_at") @db.DateTime(3)
  mfaSecret         String?   @map("mfa_secret") @db.VarChar(255)
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  roleId            BigInt    @map("role_id") @db.UnsignedBigInt
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.DateTime(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.DateTime(3)
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  role              Role               @relation(fields: [roleId], references: [id])
  sessions          Session[]
  supplierScopes    UserSupplierScope[]
  auditLogs         AuditLog[]
  impersonationLogs ImpersonationLog[] @relation("Impersonator")
  jobs              Job[]

  @@index([roleId])
  @@map("users")
}

model CustomerUser {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId        BigInt    @map("customer_id") @db.UnsignedBigInt
  loginId           String    @unique @map("login_id") @db.VarChar(20)
  name              String    @db.VarChar(100)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime? @map("password_changed_at") @db.DateTime(3)
  roleId            BigInt    @map("role_id") @db.UnsignedBigInt
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.DateTime(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.DateTime(3)
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])
  sessions Session[]

  @@index([customerId])
  @@map("customer_users")
}

model Session {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  userId         BigInt?   @map("user_id") @db.UnsignedBigInt
  customerUserId BigInt?   @map("customer_user_id") @db.UnsignedBigInt
  impersonatorId BigInt?   @map("impersonator_id") @db.UnsignedBigInt
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user         User?         @relation(fields: [userId], references: [id])
  customerUser CustomerUser? @relation(fields: [customerUserId], references: [id])

  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userType  String    @map("user_type") @db.VarChar(20)
  userId    BigInt?   @map("user_id") @db.UnsignedBigInt
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model CustomerGroup {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(100)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customers Customer[]

  @@map("customer_groups")
}

model Customer {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerCode      String    @unique @map("customer_code") @db.VarChar(20)
  name              String    @db.VarChar(200)
  nameKana          String?   @map("name_kana") @db.VarChar(200)
  shortName         String?   @map("short_name") @db.VarChar(100)
  customerGroupId   BigInt?   @map("customer_group_id") @db.UnsignedBigInt
  postalCode        String?   @map("postal_code") @db.VarChar(8)
  prefecture        String?   @db.VarChar(10)
  address           String?   @db.VarChar(255)
  phone             String?   @db.VarChar(20)
  fax               String?   @db.VarChar(20)
  contactName       String?   @map("contact_name") @db.VarChar(100)
  contractStartDate DateTime  @map("contract_start_date") @db.Date
  contractEndDate   DateTime? @map("contract_end_date") @db.Date
  isInternalTest    Boolean   @default(false) @map("is_internal_test")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customerGroup          CustomerGroup?            @relation(fields: [customerGroupId], references: [id])
  units                  Unit[]
  customerUsers          CustomerUser[]
  settings               CustomerSetting[]
  allergens              CustomerAllergen[]
  productionPatterns     CustomerProductionPattern[]
  referenceRules         CustomerReferenceRule[]
  orderSuspensions       OrderSuspension[]
  longHolidays           LongHoliday[]
  orderAlertStatuses     OrderAlertStatus[]
  documents              Document[]
  mealOrders             MealOrder[]
  riceOrders             RiceOrder[]
  allergenOrders         AllergenOrder[]
  invoices               Invoice[]

  @@index([customerGroupId])
  @@index([nameKana])
  @@map("customers")
}

model Unit {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId BigInt    @map("customer_id") @db.UnsignedBigInt
  unitCode   String    @map("unit_code") @db.VarChar(20)
  name       String    @db.VarChar(100)
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer     Customer      @relation(fields: [customerId], references: [id])
  mealOrders   MealOrder[]
  riceOrders   RiceOrder[]
  allergenOrders AllergenOrder[]

  @@unique([customerId, unitCode])
  @@map("units")
}

// ─── Masters ─────────────────────────────────────────────────────────────────

model SwallowCategory {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(50)
  sortOrder Int       @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  menuKinds MenuKind[]

  @@index([sortOrder])
  @@map("swallow_categories")
}

model MealType {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(50)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  mealOrders MealOrder[]

  @@map("meal_types")
}

model RiceType {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(50)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([sortOrder])
  @@map("rice_types")
}

model MenuKind {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code              String    @unique @db.VarChar(20)
  name              String    @db.VarChar(50)
  swallowCategoryId BigInt?   @map("swallow_category_id") @db.UnsignedBigInt
  sortOrder         Int       @default(0) @map("sort_order")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  swallowCategory SwallowCategory? @relation(fields: [swallowCategoryId], references: [id])
  mealOrders      MealOrder[]

  @@index([swallowCategoryId])
  @@map("menu_kinds")
}

model DietType {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(50)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  documentOutputRules DocumentOutputRule[]

  @@map("diet_types")
}

model AllergenType {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(50)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customerAllergens CustomerAllergen[]
  allergenOrders    AllergenOrder[]

  @@map("allergen_types")
}

model OrderType {
  id                       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code                     String    @unique @db.VarChar(20)
  name                     String    @db.VarChar(50)
  linksToProductionReports Boolean   @default(true) @map("links_to_production_reports")
  linksToSales             Boolean   @default(true) @map("links_to_sales")
  sortOrder                Int       @default(0) @map("sort_order")
  isActive                 Boolean   @default(true) @map("is_active")
  deletedAt                DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  mealOrders MealOrder[]

  @@map("order_types")
}

model CustomerSetting {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId BigInt    @map("customer_id") @db.UnsignedBigInt
  validFrom  DateTime  @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  settings   Json
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  BigInt?   @map("created_by") @db.UnsignedBigInt
  updatedBy  BigInt?   @map("updated_by") @db.UnsignedBigInt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, validFrom])
  @@map("customer_settings")
}

model CustomerAllergen {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId     BigInt    @map("customer_id") @db.UnsignedBigInt
  allergenTypeId BigInt    @map("allergen_type_id") @db.UnsignedBigInt
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer     Customer     @relation(fields: [customerId], references: [id])
  allergenType AllergenType @relation(fields: [allergenTypeId], references: [id])

  @@unique([customerId, allergenTypeId])
  @@map("customer_allergens")
}

model DeadlineRule {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(100)
  scopeType   String    @map("scope_type") @db.VarChar(20)
  scopeId     BigInt?   @map("scope_id") @db.UnsignedBigInt
  orderTypeId BigInt?   @map("order_type_id") @db.UnsignedBigInt
  dayOffset   Int       @map("day_offset")
  cutoffTime  String    @map("cutoff_time") @db.VarChar(5)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  exceptions DeadlineException[]

  @@map("deadline_rules")
}

model DeadlineException {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  deadlineRuleId BigInt   @map("deadline_rule_id") @db.UnsignedBigInt
  serviceDate    DateTime @map("service_date") @db.Date
  dayOffset      Int      @map("day_offset")
  cutoffTime     String   @map("cutoff_time") @db.VarChar(5)
  reason         String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  deadlineRule DeadlineRule @relation(fields: [deadlineRuleId], references: [id])

  @@unique([deadlineRuleId, serviceDate])
  @@map("deadline_exceptions")
}

model BusinessCalendar {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  calDate   DateTime @unique @map("cal_date") @db.Date
  isHoliday Boolean  @default(false) @map("is_holiday")
  note      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("business_calendars")
}

model OrderSuspension {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId BigInt    @map("customer_id") @db.UnsignedBigInt
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  reason     String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, startDate])
  @@map("order_suspensions")
}

model Announcement {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title           String    @db.VarChar(200)
  body            String    @db.Text
  category        String    @db.VarChar(50)
  severity        String    @default("info") @db.VarChar(20)
  isPinned        Boolean   @default(false) @map("is_pinned")
  publishFrom     DateTime  @map("publish_from") @db.DateTime(3)
  publishTo       DateTime? @map("publish_to") @db.DateTime(3)
  audience        String    @default("all") @db.VarChar(20)
  targetScopeType String    @default("all") @map("target_scope_type") @db.VarChar(20)
  targetScopeId   BigInt?   @map("target_scope_id") @db.UnsignedBigInt
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  reads AnnouncementRead[]

  @@index([publishFrom, publishTo])
  @@map("announcements")
}

model AnnouncementRead {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  announcementId BigInt   @map("announcement_id") @db.UnsignedBigInt
  readerType     String   @map("reader_type") @db.VarChar(20)
  readerId       BigInt   @map("reader_id") @db.UnsignedBigInt
  readAt         DateTime @default(now()) @map("read_at") @db.DateTime(3)

  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@unique([announcementId, readerType, readerId])
  @@index([readerType, readerId])
  @@map("announcement_reads")
}

model LongHoliday {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId BigInt?   @map("customer_id") @db.UnsignedBigInt
  name       String?   @db.VarChar(100)
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  reason     String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId, startDate, endDate])
  @@map("long_holidays")
}

model OrderAlertStatus {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId  BigInt    @map("customer_id") @db.UnsignedBigInt
  serviceDate DateTime  @map("service_date") @db.Date
  status      String    @default("unhandled") @db.VarChar(20)
  handledBy   BigInt?   @map("handled_by") @db.UnsignedBigInt
  handledAt   DateTime? @map("handled_at") @db.DateTime(3)
  note        String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, serviceDate])
  @@index([status])
  @@map("order_alert_statuses")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model MealOrder {
  id          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  customerId  BigInt          @map("customer_id") @db.UnsignedBigInt
  unitId      BigInt          @map("unit_id") @db.UnsignedBigInt
  serviceDate DateTime        @map("service_date") @db.Date
  mealTypeId  BigInt          @map("meal_type_id") @db.UnsignedBigInt
  menuKindId  BigInt          @map("menu_kind_id") @db.UnsignedBigInt
  orderTypeId BigInt          @map("order_type_id") @db.UnsignedBigInt
  quantity            Int             @default(0)
  provisionalQuantity Int?            @map("provisional_quantity")
  status              MealOrderStatus @default(draft)
  confirmedAt         DateTime?       @map("confirmed_at") @db.DateTime(3)
  orderedByType       String?         @map("ordered_by_type") @db.VarChar(20)
  orderedById         BigInt?         @map("ordered_by_id") @db.UnsignedBigInt
  version             Int             @default(0)
  createdAt           DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy           BigInt?         @map("created_by") @db.UnsignedBigInt
  updatedBy           BigInt?         @map("updated_by") @db.UnsignedBigInt

  customer  Customer  @relation(fields: [customerId], references: [id])
  unit      Unit      @relation(fields: [unitId], references: [id])
  mealType  MealType  @relation(fields: [mealTypeId], references: [id])
  menuKind  MenuKind  @relation(fields: [menuKindId], references: [id])
  orderType OrderType @relation(fields: [orderTypeId], references: [id])
  changeLogs OrderChangeLog[]

  @@unique([unitId, serviceDate, mealTypeId, menuKindId, orderTypeId])
  @@index([customerId, serviceDate])
  @@index([serviceDate, status])
  @@map("meal_orders")
}

model RiceOrder {
  id          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  customerId  BigInt          @map("customer_id") @db.UnsignedBigInt
  unitId      BigInt          @map("unit_id") @db.UnsignedBigInt
  serviceDate DateTime        @map("service_date") @db.Date
  riceType    String          @map("rice_type") @db.VarChar(20)
  quantity    Int             @default(0)
  status      MealOrderStatus @default(draft)
  version     Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])

  @@unique([unitId, serviceDate, riceType])
  @@map("rice_orders")
}

model AllergenOrder {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  customerId     BigInt          @map("customer_id") @db.UnsignedBigInt
  unitId         BigInt          @map("unit_id") @db.UnsignedBigInt
  serviceDate    DateTime        @map("service_date") @db.Date
  allergenTypeId BigInt          @map("allergen_type_id") @db.UnsignedBigInt
  quantity       Int             @default(0)
  status         MealOrderStatus @default(draft)
  version        Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  customer     Customer     @relation(fields: [customerId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
  allergenType AllergenType @relation(fields: [allergenTypeId], references: [id])

  @@unique([unitId, serviceDate, allergenTypeId])
  @@map("allergen_orders")
}

model OrderChangeLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  mealOrderId BigInt   @map("meal_order_id") @db.UnsignedBigInt
  fieldName   String   @map("field_name") @db.VarChar(50)
  beforeValue   String?  @map("before_value") @db.VarChar(50)
  afterValue    String?  @map("after_value") @db.VarChar(50)
  reason        String?  @db.VarChar(255)
  changedBy     BigInt?  @map("changed_by") @db.UnsignedBigInt
  changedByType String?  @map("changed_by_type") @db.VarChar(20)
  changedAt     DateTime @default(now()) @map("changed_at") @db.DateTime(3)

  mealOrder MealOrder @relation(fields: [mealOrderId], references: [id])

  @@index([mealOrderId])
  @@map("order_change_logs")
}

// ─── Documents ───────────────────────────────────────────────────────────────

model File {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  storageKey   String   @map("storage_key") @db.VarChar(500)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt   @map("size_bytes") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy    BigInt?  @map("created_by") @db.UnsignedBigInt

  documentVersions DocumentVersion[]

  @@map("files")
}

model Document {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId   BigInt?   @map("customer_id") @db.UnsignedBigInt
  documentType String    @map("document_type") @db.VarChar(50)
  title        String    @db.VarChar(200)
  serviceMonth String    @map("service_month") @db.VarChar(7)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer?         @relation(fields: [customerId], references: [id])
  versions DocumentVersion[]

  @@index([customerId, serviceMonth])
  @@map("documents")
}

model DocumentVersion {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  documentId       BigInt    @map("document_id") @db.UnsignedBigInt
  versionNo        Int       @map("version_no")
  fileId           BigInt    @map("file_id") @db.UnsignedBigInt
  settingsSnapshot Json      @map("settings_snapshot")
  generatedAt      DateTime  @map("generated_at") @db.DateTime(3)
  generatedBy      BigInt    @map("generated_by") @db.UnsignedBigInt
  supersededAt     DateTime? @map("superseded_at") @db.DateTime(3)

  document Document @relation(fields: [documentId], references: [id])
  file     File     @relation(fields: [fileId], references: [id])

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

model DocumentOutputRule {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  dietTypeCode String    @map("diet_type_code") @db.VarChar(20)
  documentType String    @map("document_type") @db.VarChar(50)
  isEnabled    Boolean   @default(true) @map("is_enabled")
  sortOrder    Int       @default(0) @map("sort_order")
  validFrom    DateTime  @default(dbgenerated("'2020-01-01'")) @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  dietType DietType @relation(fields: [dietTypeCode], references: [code])

  @@unique([dietTypeCode, documentType, validFrom], map: "dor_diet_doc_from_key")
  @@map("document_output_rules")
}

model MenuTemplate {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String    @db.VarChar(200)
  body       String    @db.Text
  tags       Json?
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  useCount   Int       @default(0) @map("use_count")
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(3)
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  platingInstructions PlatingInstruction[]

  @@map("menu_templates")
}

model PlatingInstruction {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  serviceDate      DateTime @map("service_date") @db.Date
  menuTemplateId   BigInt?  @map("menu_template_id") @db.UnsignedBigInt
  bodySnapshot     String   @map("body_snapshot") @db.Text
  settingsSnapshot Json     @map("settings_snapshot")
  isVisible        Boolean  @default(true) @map("is_visible")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy        BigInt?  @map("created_by") @db.UnsignedBigInt

  menuTemplate MenuTemplate? @relation(fields: [menuTemplateId], references: [id])

  @@index([serviceDate])
  @@map("plating_instructions")
}

// ─── Procurement & Inventory ─────────────────────────────────────────────────

model Supplier {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(200)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  stockItems     StockItem[]
  userScopes     UserSupplierScope[]
  orderSchedules OrderSchedule[]
  importBatches  ImportBatch[]

  @@map("suppliers")
}

model UserSupplierScope {
  userId     BigInt @map("user_id") @db.UnsignedBigInt
  supplierId BigInt @map("supplier_id") @db.UnsignedBigInt

  user     User     @relation(fields: [userId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@id([userId, supplierId])
  @@map("user_supplier_scopes")
}

model StockItem {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  supplierId BigInt    @map("supplier_id") @db.UnsignedBigInt
  itemCode   String    @map("item_code") @db.VarChar(50)
  name       String    @db.VarChar(200)
  category   String?   @db.VarChar(100)
  unit       String    @db.VarChar(20)
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  orderSchedules OrderSchedule[]
  stockRecords   StockRecord[]

  @@unique([supplierId, itemCode])
  @@index([category])
  @@map("stock_items")
}

model ProductionPattern {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code            String    @unique @db.VarChar(20)
  name            String    @db.VarChar(100)
  leadDays        Int       @map("lead_days")
  pickupOffsetD0  Int       @default(0) @map("pickup_offset_d0")
  pickupOffsetD1  Int       @default(1) @map("pickup_offset_d1")
  pickupOffsetD2  Int       @default(2) @map("pickup_offset_d2")
  pickupOffsetD3  Int       @default(3) @map("pickup_offset_d3")
  arrivalOffsetD1 Int       @default(1) @map("arrival_offset_d1")
  arrivalOffsetD2 Int       @default(2) @map("arrival_offset_d2")
  arrivalOffsetD3 Int       @default(3) @map("arrival_offset_d3")
  carrierCode     String?   @map("carrier_code") @db.VarChar(20)
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customerAssignments CustomerProductionPattern[]

  @@map("production_patterns")
}

model CustomerProductionPattern {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId          BigInt    @map("customer_id") @db.UnsignedBigInt
  productionPatternId BigInt    @map("production_pattern_id") @db.UnsignedBigInt
  validFrom           DateTime  @map("valid_from") @db.Date
  validTo             DateTime? @map("valid_to") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  customer          Customer          @relation(fields: [customerId], references: [id])
  productionPattern ProductionPattern @relation(fields: [productionPatternId], references: [id])

  @@index([customerId, validFrom])
  @@map("customer_production_patterns")
}

model ReferenceRule {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  ruleConfig  Json      @map("rule_config")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customerRules CustomerReferenceRule[]

  @@map("reference_rules")
}

model CustomerReferenceRule {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId      BigInt    @map("customer_id") @db.UnsignedBigInt
  referenceRuleId BigInt    @map("reference_rule_id") @db.UnsignedBigInt
  validFrom       DateTime  @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  customer      Customer      @relation(fields: [customerId], references: [id])
  referenceRule ReferenceRule @relation(fields: [referenceRuleId], references: [id])

  @@index([customerId, validFrom])
  @@map("customer_reference_rules")
}

model OrderSchedule {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  supplierId     BigInt    @map("supplier_id") @db.UnsignedBigInt
  stockItemId    BigInt    @map("stock_item_id") @db.UnsignedBigInt
  deliveryDate   DateTime  @map("delivery_date") @db.Date
  orderQuantity  Decimal   @map("order_quantity") @db.Decimal(12, 3)
  stockQuantity  Decimal?  @map("stock_quantity") @db.Decimal(12, 3)
  status         String    @default("draft") @db.VarChar(20)
  calcSnapshot   Json?     @map("calc_snapshot")
  version        Int       @default(0)
  confirmedAt    DateTime? @map("confirmed_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy      BigInt?   @map("updated_by") @db.UnsignedBigInt

  supplier    Supplier                   @relation(fields: [supplierId], references: [id])
  stockItem   StockItem                  @relation(fields: [stockItemId], references: [id])
  references  OrderScheduleReference[]

  @@unique([stockItemId, deliveryDate])
  @@index([supplierId, deliveryDate])
  @@map("order_schedules")
}

model OrderScheduleReference {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderScheduleId BigInt   @map("order_schedule_id") @db.UnsignedBigInt
  customerId      BigInt   @map("customer_id") @db.UnsignedBigInt
  referenceDate   DateTime @map("reference_date") @db.Date
  referenceQty    Decimal  @map("reference_qty") @db.Decimal(12, 3)
  fallbackUsed    Boolean  @default(false) @map("fallback_used")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  orderSchedule OrderSchedule @relation(fields: [orderScheduleId], references: [id])

  @@index([orderScheduleId])
  @@map("order_schedule_references")
}

model StockRecord {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  stockItemId  BigInt   @map("stock_item_id") @db.UnsignedBigInt
  recordDate   DateTime @map("record_date") @db.Date
  quantity     Decimal  @db.Decimal(12, 3)
  recordType   String   @map("record_type") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy    BigInt?  @map("created_by") @db.UnsignedBigInt

  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@index([stockItemId, recordDate])
  @@map("stock_records")
}

model ImportBatch {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  supplierId   BigInt    @map("supplier_id") @db.UnsignedBigInt
  fileType     String    @map("file_type") @db.VarChar(50)
  status       JobStatus @default(pending)
  errorCount   Int       @default(0) @map("error_count")
  successCount Int       @default(0) @map("success_count")
  params       Json?
  startedAt    DateTime? @map("started_at") @db.DateTime(3)
  completedAt  DateTime? @map("completed_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  createdBy    BigInt?   @map("created_by") @db.UnsignedBigInt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, createdAt])
  @@map("import_batches")
}

model IngredientMapping {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sourceName      String   @map("source_name") @db.VarChar(200)
  stockItemId     BigInt   @map("stock_item_id") @db.UnsignedBigInt
  confidenceScore Decimal? @map("confidence_score") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([sourceName])
  @@map("ingredient_mappings")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Invoice {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  customerId    BigInt        @map("customer_id") @db.UnsignedBigInt
  invoiceMonth  String        @map("invoice_month") @db.VarChar(7)
  status        InvoiceStatus @default(draft)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  version       Int           @default(1)
  issuedAt      DateTime?     @map("issued_at") @db.DateTime(3)
  settingsSnapshot Json?      @map("settings_snapshot")
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer      @relation(fields: [customerId], references: [id])
  lines    InvoiceLine[]

  @@unique([customerId, invoiceMonth, version])
  @@map("invoices")
}

model InvoiceLine {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  invoiceId   BigInt  @map("invoice_id") @db.UnsignedBigInt
  lineNo      Int     @map("line_no")
  description String  @db.VarChar(255)
  quantity    Int     @default(0)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  lineType    String  @map("line_type") @db.VarChar(20)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ─── Infrastructure ──────────────────────────────────────────────────────────

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt?  @map("user_id") @db.UnsignedBigInt
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(50)
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ImpersonationLog {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  impersonatorId   BigInt   @map("impersonator_id") @db.UnsignedBigInt
  customerId       BigInt   @map("customer_id") @db.UnsignedBigInt
  startedAt        DateTime @default(now()) @map("started_at") @db.DateTime(3)
  endedAt          DateTime? @map("ended_at") @db.DateTime(3)

  impersonator User @relation("Impersonator", fields: [impersonatorId], references: [id])

  @@index([impersonatorId])
  @@map("impersonation_logs")
}

model Job {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  jobType     String    @map("job_type") @db.VarChar(50)
  status      JobStatus @default(pending)
  progress    Int       @default(0)
  params      Json?
  result      Json?
  error       String?   @db.Text
  startedAt   DateTime? @map("started_at") @db.DateTime(3)
  completedAt DateTime? @map("completed_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  createdBy   BigInt?   @map("created_by") @db.UnsignedBigInt

  user User?    @relation(fields: [createdBy], references: [id])
  logs JobLog[]

  @@index([status, createdAt])
  @@map("jobs")
}

model JobLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  jobId     BigInt   @map("job_id") @db.UnsignedBigInt
  level     String   @db.VarChar(10)
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("job_logs")
}

model Notification {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt?  @map("user_id") @db.UnsignedBigInt
  customerUserId BigInt?  @map("customer_user_id") @db.UnsignedBigInt
  title          String   @db.VarChar(200)
  body           String   @db.Text
  category       String   @db.VarChar(50)
  isRead         Boolean  @default(false) @map("is_read")
  linkUrl        String?  @map("link_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([userId, isRead])
  @@index([customerUserId, isRead])
  @@map("notifications")
}

model SystemSetting {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  key       String   @unique @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("system_settings")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RoleScope {
  internal
  facility
}

enum MealOrderStatus {
  draft
  provisional
  confirmed
  cancelled
}

enum JobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum InvoiceStatus {
  draft
  issued
  corrected
  cancelled
}
